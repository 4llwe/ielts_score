{
  "name": "ielts-mate-platform",
  "version": "5.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "netlify dev",
    "check": "node scripts-check.mjs",
    "deploy": "netlify deploy --prod",
    "check:production": "node scripts/verify-production.mjs",
    "check:security": "node scripts/security-check.mjs",
    "check:release": "node scripts/release-check.mjs",
    "verify": "npm run check && npm run check:security && npm run check:release && npm run build",
    "check:evidence": "node scripts/readiness-evidence-check.mjs",
    "build": "node scripts/build.mjs"
  },
  "dependencies": {
    "@netlify/blobs": "^9.1.2",
    "bcryptjs": "^3.0.2",
    "jose": "^6.0.8"
  },
  "devDependencies": {
    "netlify-cli": "^23.5.0"
  },
  "engines": {
    "node": ">=20"
  }
}
